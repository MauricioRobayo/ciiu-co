{
  "name": "ciiu-co",
  "version": "1.2.0",
  "description": "Complete Colombian CIIU Rev. 4 A.C. classification (502 clases): code dictionary, hierarchy, and ARL occupational risk classification per Decreto 768 de 2022",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./arl": {
      "types": "./arl.d.ts",
      "import": "./arl.js"
    },
    "./dict": {
      "types": "./dict.d.ts",
      "import": "./dict.js"
    },
    "./tree": {
      "types": "./tree.d.ts",
      "import": "./tree.js"
    },
    "./ciiu-dict.json": "./ciiu-dict.json",
    "./ciiu-tree.json": "./ciiu-tree.json",
    "./risk-classification.json": "./risk-classification.json"
  },
  "scripts": {
    "check": "node check.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "arl.js",
    "arl.d.ts",
    "dict.js",
    "dict.d.ts",
    "tree.js",
    "tree.d.ts",
    "ciiu-dict.json",
    "ciiu-tree.json",
    "risk-classification.json"
  ],
  "keywords": [
    "ciiu",
    "ciiu4",
    "clasificador",
    "dane",
    "colombia",
    "economia",
    "arl",
    "riesgo-laboral"
  ],
  "author": "Mauricio Robayo",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MauricioRobayo/ciiu-co.git"
  }
}
